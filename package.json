{
  "name": "glaceon-masterset",
  "private": true,
  "version": "0.7.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "cross-env FIREBASE_EMULATOR_JAVA_PATH= FIREBASE_EMULATOR_FIRESTORE_ONLY=true firebase emulators:exec --only firestore --project glaceon-master-set \"vitest run tests/firestore.rules.emulator.test.js\"",
    "test:rules": "vitest run tests/lib/firestore.rules.unit.test.js",
    "test:a11y": "vitest run tests/a11y",
    "test:functions": "cd functions && npm test",
    "preview": "vite preview",
    "validate": "npm run lint && npm run test:rules && npm run test:a11y && npm test && npm run test:functions && npm run build && node scripts/check-csp.js && node scripts/check-bundle.js",
    "security:audit": "npm audit --audit-level=moderate",
    "bundle:analyze": "npx vite-bundle-analyzer dist"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.0.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.4",
    "vitest-axe": "^0.1.0"
  }
}
